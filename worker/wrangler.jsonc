{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aigc-weekly-worker",
  "main": "./index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "upload_source_maps": true,
  "keep_vars": true,
  "observability": {
    "traces": {
      "enabled": true
    },
    "logs": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "r2_buckets": [
    {
      "binding": "AGENT_STORAGE",
      "bucket_name": "aigc-weekly"
    }
  ],
  "workflows": [
    {
      "name": "aigc-weekly-workflow",
      "binding": "WEEKLY_WORKFLOW",
      "class_name": "WeeklyWorkflow",
      "schedules": ["0 23 * * 7"]
    }
  ]
}
