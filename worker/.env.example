# Worker API Basic Auth
SERVER_USERNAME=drdata
SERVER_PASSWORD=server-password

# Payload CMS
PAYLOAD_BASE_URL=https://ai.shor.lol
PAYLOAD_API_KEY=payload-api-key

# GitHub Issue（周刊草稿审核，固定发布到 dr-data/aigc-weekly）
GITHUB_TOKEN=github-personal-access-token

# 可选：研究进度通知（Slack/Discord Webhook URL）
PROGRESS_WEBHOOK_URL=

# 可选：逗号分隔，临时禁用指定来源名称
DISABLED_SOURCES=

# 可选：提高 Jina Reader 限额；留空时使用公开接口
JINA_API_KEY=
